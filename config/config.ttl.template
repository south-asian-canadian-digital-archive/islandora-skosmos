@prefix dc: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix skosmos: <http://purl.org/net/skosmos#> .
@prefix void: <http://rdfs.org/ns/void#> .
@prefix : <#> .

:config a skosmos:Configuration ;
    skosmos:sparqlEndpoint <${SPARQL_ENDPOINT}> ;
    skosmos:sparqlDialect "Generic" ;
    skosmos:sparqlCollationEnabled false ;
    skosmos:serviceName "${SERVICE_NAME}" ;
    skosmos:baseHref "${PUBLIC_URL}/skosmos/" ;
    skosmos:languages ( [ rdfs:label "en" ; rdf:value "en_GB.utf8" ] ) ;
    skosmos:templateCache "/tmp/skosmos-template-cache" .

:${VOCAB_ID} a skosmos:Vocabulary, void:Dataset ;
    dc:title "${SERVICE_NAME}"@en ;
    skosmos:shortName "${VOCAB_ID}" ;
    dc:subject :cat_general ;
    void:uriSpace "${PUBLIC_URL}${BASE_PATH}" ;
    skosmos:language "en" ;
    skosmos:defaultLanguage "en" ;
    skosmos:showTopConcepts true ;
    skosmos:mainConceptScheme <${PUBLIC_URL}${SCHEME_PATH}> ;
    void:sparqlEndpoint <${SPARQL_ENDPOINT}> ;
    skosmos:sparqlGraph <${PUBLIC_URL}${BASE_PATH}> .

:categories a skos:ConceptScheme ; skos:prefLabel "Vocabularies"@en .
:cat_general a skos:Concept ; skos:topConceptOf :categories ; skos:inScheme :categories ; skos:prefLabel "General"@en .
